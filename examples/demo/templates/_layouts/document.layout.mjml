<mjml lang="$lang">
  <mj-head>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" line-height="1.55" color="#1f2937" padding="4px 0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-table font-size="13px" color="#1f2937" padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body width="680px" background-color="#ffffff">

    <mj-section padding="0 0 28px">
      <mj-column width="50%">
        <mj-image src="{{ assets_url }}/logo.svg" width="40px" align="left" padding="0" alt="Acme" />
      </mj-column>
      <mj-column width="50%">
        <mj-text align="right" font-size="12px" color="#4b5563">Acme S.L. · B-00000000<br>Calle Ejemplo 1, 28000 Madrid</mj-text>
      </mj-column>
    </mj-section>

    $content

  </mj-body>
</mjml>
