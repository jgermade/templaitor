<mjml lang="$lang">
  <mj-head>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, sans-serif" />
      <mj-text font-size="14px" line-height="1.6" color="#333333" />
      <mj-button background-color="#4F46E5" border-radius="6px" font-size="14px" font-weight="600" inner-padding="12px 24px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f5">

    <mj-section background-color="#ffffff" padding="32px 24px 0">
      <mj-column>
        <mj-image src="{{ assets_url }}/logo.svg" width="36px" align="left" padding="0 25px" alt="Acme" />
      </mj-column>
    </mj-section>

    $content

    $import(_components/footer)

  </mj-body>
</mjml>
