---
layout: base.layout.mjml
---

<mj-section background-color="#ffffff" padding="24px 24px 0">
  <mj-column>
    <mj-text font-size="20px" font-weight="600" color="#111827">$t('title')</mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#ffffff" padding="16px 24px">
  <mj-column>
    <mj-text>$t('greeting')</mj-text>
    <mj-text>$t('intro')</mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#ffffff" padding="8px 24px 32px">
  <mj-column>
    <mj-button href="{{ app_url }}/verify?token={{ verification_token }}">$t('cta')</mj-button>
  </mj-column>
</mj-section>

<mj-section background-color="#f9fafb" padding="16px 24px">
  <mj-column>
    <mj-text font-size="12px" color="#6b7280">$t('expiry')</mj-text>
    <mj-text font-size="12px" color="#6b7280">$t('ignore')</mj-text>
  </mj-column>
</mj-section>
