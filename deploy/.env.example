# Public URL of the service (passkeys and links depend on it; HTTPS in production)
TEMPLAITOR_BASE_URL=https://templaitor.example.com
# Encrypts the organizations' SMTP passwords: ≥ 32 random characters (openssl rand -base64 48). Keep it stable.
TEMPLAITOR_SECRET=
# open (anyone can sign up) · invite (only invited emails)
TEMPLAITOR_SIGNUP=invite
# fs (a project folder per org) · db (projects stored in the database)
TEMPLAITOR_STORAGE=fs
# Database: SQLite in the data volume by default. Postgres: use deploy/docker-compose.postgres.yml and set
# POSTGRES_PASSWORD (or point TEMPLAITOR_DATABASE_URL to your own server)
# POSTGRES_PASSWORD=
# TEMPLAITOR_DATABASE_URL=postgres://user:pass@host:5432/templaitor
# Days the HTML/text/attachments of sent messages are kept in the send log (0 = forever)
TEMPLAITOR_RETENTION_DAYS=30
# Behind a reverse proxy: take the client IP from X-Forwarded-For
TEMPLAITOR_TRUST_PROXY=true
# System SMTP for sign-in codes and invitations
TEMPLAITOR_SMTP_HOST=
TEMPLAITOR_SMTP_PORT=587
TEMPLAITOR_SMTP_SECURE=false
TEMPLAITOR_SMTP_USER=
TEMPLAITOR_SMTP_PASS=
TEMPLAITOR_SMTP_FROM=templaitor <no-reply@example.com>
