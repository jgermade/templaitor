{
  "name": "templaitor",
  "version": "0.1.6",
  "description": "Generic MJML template editor with Jinja2 output, WYSIWYG editing, reusable components and accessible PDFs",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./engine/*": "./src/engine/*.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "templaitor": "bin/templaitor.js"
  },
  "files": [
    "bin",
    "src",
    "dist/editor",
    "templaitor.config.yml",
    "templates",
    ".templaitor",
    "templates.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "editor": "node bin/templaitor.js editor --cwd examples/demo",
    "compile": "node bin/templaitor.js compile --cwd examples/demo",
    "test": "node --test test/*.test.js",
    "prepare": "vite build --config vite.config.js",
    "build:demo": "vite build --config vite.demo.config.js && node scripts/build-demo-pdfs.mjs",
    "build:site": "node scripts/build-site.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0",
    "chokidar": "^3.6.0",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^10.1.0",
    "json5": "^2.2.3",
    "mjml": "^5.4.1",
    "nodemailer": "^10.6.1",
    "nunjucks": "^3.2.4",
    "pg": "^8.16.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@simplewebauthn/browser": "^14.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "codemirror": "^6.0.2",
    "country-flag-icons": "^1.6.20",
    "mjml-browser": "^5.4.1",
    "svelte": "^5.58.0",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "playwright": ">=1.42"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
